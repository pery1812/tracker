# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API Keys (and Data API for the URL).
# Only VITE_-prefixed variables reach the browser. Use the PUBLISHABLE key (or the legacy
# "anon" key) here — never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
